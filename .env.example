# Public URL of the site (used for SEO metadata and the sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Team inbox at /admin — set a strong password to enable it
ADMIN_PASSWORD=
# Optional: separate secret used to sign the admin session cookie
ADMIN_SECRET=

# AI concierge — without a key it answers from a built-in knowledge base
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Email notifications for new messages, briefs, bookings and chats (e.g. Gmail + app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ayoub.orizon@gmail.com
SMTP_PASS=
NOTIFY_EMAIL=ayoub.orizon@gmail.com

# Persistent storage in production (Upstash Redis REST). Without it, data is
# saved to ./.data locally or /tmp on Vercel (which is NOT persistent).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
